# ══════════════════════════════════════════════════════════════════════════════
# RailMind Backend — SHARED env template (secrets + values common to every env).
#
# Config is environment-switched across THREE files. Copy each into its real
# counterpart and fill in values — never commit the real .env* files:
#   .sample.env        ->  .env         (this file: shared secrets + DB creds)
#   .sample.env.local  ->  .env.local   (local Postgres on your machine)
#   .sample.env.prod   ->  .env.prod    (VM Postgres via SSH tunnel)
#
# Pick the environment with a REAL shell variable (NOT inside any .env file —
# it decides WHICH file gets read). Defaults to "local":
#   export APP_ENV=local      # local Postgres  (or: APP_ENV=local uvicorn ...)
#   export APP_ENV=prod       # VM Postgres     (open the SSH tunnel first)
#
# Loaded as env_file=(".env", ".env.<APP_ENV>") — the .env.<env> value WINS on
# any key it also defines. A real OS env var (e.g. docker-compose DB_HOST=postgres)
# beats both files.
# ══════════════════════════════════════════════════════════════════════════════

DEV_AUTH_BYPASS=false                   # set true only in local dev to skip auth

# WEB_CONCURRENCY=2                      # uvicorn workers on the server (docker prod only; ≈ CPU cores)

# ── Database (credentials are identical across envs; host/port live in .env.<env>) ─
DB_NAME=railmind_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_SCHEMA=railmind_be
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
ECHO=false

# ── URLs ───────────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000

# ── SMTP / Email ───────────────────────────────────────────────────────────────
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_USER=your_smtp_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password    # Gmail: use an App Password, not your login password
MAIL_FROM=noreply@railmind.in
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# ── Security / Encryption ──────────────────────────────────────────────────────
# Generate JWT secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=90
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate HMAC secret: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET_KEY=your_hmac_secret_key

# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KYC_ENCRYPTION_KEY=your_fernet_key

# ── RapidAPI (IRCTC) ───────────────────────────────────────────────────────────
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_NAME=Gemini API Key
GEMINI_API_PROJECT_NAME=projects/your_project_id
GEMINI_API_PROJECT_NUMBER=your_project_number
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_TICKET_BUCKET=tickets
SUPABASE_IMAGE_BUCKET=images

# ── Payment ────────────────────────────────────────────────────────────────────
PAYMENT_MODE=mock                       # mock | razorpay

# Mock payment — test credentials (only used when PAYMENT_MODE=mock)
MOCK_VALID_CREDIT_CARD=4242424242424242
MOCK_VALID_DEBIT_CARD=1212121212121212
MOCK_VALID_UPI_ID=test@upi
MOCK_VALID_NETBANKING_USER=testuser
MOCK_VALID_NETBANKING_PASS=testpass
MOCK_VALID_CVV=123

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PROVIDER=google

# Live train running status (via RapidAPI - train-running-api)
RAPIDAPI_LIVE_STATUS_KEY=your_rapidapi_live_status_key
RAPIDAPI_LIVE_STATUS_HOST=train-running-api.p.rapidapi.com
RAPIDAPI_LIVE_STATUS_BASE_URL=https://train-running-api.p.rapidapi.com
RAPIDAPI_LIVE_STATUS_TIMEOUT_SECONDS=15
