# ══════════════════════════════════════════════════════════════════════════════
# PROD environment overrides (APP_ENV=prod). Copy to .env.prod.
#
# Targets the VM Postgres FROM your local machine. The VM's Postgres (5432) is
# NOT publicly exposed — open the SSH tunnel FIRST and keep it running, else
# every connection times out:
#   ssh -i ~/.ssh/<your_key> -N -L 5433:localhost:5432 <ssh_user>@<vm_host>
# Then the app/alembic reach the VM DB through 127.0.0.1:5433.
#
# NOTE: inside the VM's docker containers, docker-compose sets DB_HOST=postgres
# as a real env var, which overrides the DB_HOST below — so this 127.0.0.1:5433
# only applies to running locally-against-prod through the tunnel.
# ══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=prod
DEBUG=false                             # cookies none+secure

DB_HOST=127.0.0.1
DB_PORT=5433

API_BASE_URL=http://your-vm-host
CORS_ORIGINS=https://your-frontend-domain

# WEB_CONCURRENCY=2                      # only read by docker-compose on the server
