# RailMind — environment template.
# Copy to `.env` and fill in the values. NEVER commit a real `.env`.
#
# Values left blank below are SECRETS — in production they should come from a
# secret manager (GCP Secret Manager / Vault / AWS Secrets Manager), not a file.
# See the "SECRET-MANAGER KEYS" list at the bottom.

# ENVIRONMENT
ENVIRONMENT=dev
DEBUG=false
DEV_AUTH_BYPASS=false

# DATABASE (local — VM uses postgres/railmind)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=railmind_db
DB_USERNAME=railmind
DB_PASSWORD=                      # secret
DB_SCHEMA=railmind_be
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
ECHO=false

# BASE URLS (local — VM: https://railmind.ddns.net)
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# SMTP CONFIGURATION
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=              # secret (Gmail app-password)
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# REDIS / CELERY (local — VM: redis://redis:6379/0)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# JWT / SESSION
JWT_SECRET_KEY=                   # secret (strong random, e.g. `openssl rand -base64 48`)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=90
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_REFRESH_TOKEN_EXPIRE_HOURS=24

# HMAC / KYC ENCRYPTION
HMAC_SECRET_KEY=                  # secret (32-byte random)
KYC_ENCRYPTION_KEY=               # secret (Fernet key — `Fernet.generate_key()`)

# RAPID API
RAPIDAPI_KEY=                     # secret
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# GEMINI API
GEMINI_API_KEY=                   # secret
GEMINI_API_KEY_NAME=Gemini API Key
GEMINI_API_PROJECT_NAME=projects/your-project-number
GEMINI_API_PROJECT_NUMBER=your-project-number
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# SUPABASE (single root bucket; tickets/images/trending are folders)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=                     # secret (the service/secret key, NOT the anon key)
SUPABASE_BUCKET=railmind
SUPABASE_TICKET_FOLDER=tickets
SUPABASE_IMAGE_FOLDER=images
SUPABASE_TRENDING_FOLDER=trending

# PAYMENT (mock | razorpay) — MOCK_* are public test fixtures, not secrets
PAYMENT_MODE=mock
MOCK_VALID_CREDIT_CARD=4242424242424242
MOCK_VALID_DEBIT_CARD=1212121212121212
MOCK_VALID_UPI_ID=test@upi
MOCK_VALID_NETBANKING_USER=testuser
MOCK_VALID_NETBANKING_PASS=testpass
MOCK_VALID_CVV=123

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=             # secret
GOOGLE_PROVIDER=google

# REPLICATE
REPLICATE_API_TOKEN=              # secret
REPLICATE_TEMPERATURE=0.2
REPLICATE_MAX_TOKENS=2048

# TWILIO (WhatsApp OTP)
TWILIO_ACCOUNT_SID=               # secret-ish (account identifier)
TWILIO_AUTH_TOKEN=               # secret
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ──────────────────────────────────────────────────────────────────────────────
# SECRET-MANAGER KEYS — pull these from a secret manager in prod (never a file):
#   DB_PASSWORD, EMAIL_SMTP_PASSWORD, JWT_SECRET_KEY, HMAC_SECRET_KEY,
#   KYC_ENCRYPTION_KEY, RAPIDAPI_KEY, GEMINI_API_KEY, SUPABASE_KEY,
#   GOOGLE_CLIENT_SECRET, REPLICATE_API_TOKEN, TWILIO_AUTH_TOKEN
#   (borderline / identifiers, good to vault too): TWILIO_ACCOUNT_SID, DB_USERNAME
# ──────────────────────────────────────────────────────────────────────────────
