# ══════════════════════════════════════════════════════════════════════════════
# LOCAL environment overrides (APP_ENV=local, the default).
# Copy to .env.local. Layered on top of .env — talks to Postgres on THIS machine.
# ══════════════════════════════════════════════════════════════════════════════

ENVIRONMENT=local                       # dev | staging | prod
DEBUG=true                              # true = cookies lax+insecure (local dev)

DB_HOST=localhost
DB_PORT=5432

API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional cookie overrides (defaults are derived from DEBUG):
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
